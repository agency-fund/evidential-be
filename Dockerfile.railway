# Defines a production runtime environment for the service hosted on Railway.
# This is not for development uses.

# The builder stage needs gcc, pg_config, and git to build and fetch dependencies (incl psycopg2).
FROM python:3.14-trixie AS builder
COPY --from=ghcr.io/astral-sh/uv:0.13.5 /uv /uvx /bin/
ENV UV_COMPILE_BYTECODE=1
ENV UV_LINK_MODE=copy
ENV UV_PYTHON_DOWNLOADS=0
ENV UV_PYTHON_PREFERENCE=only-system
WORKDIR /code
COPY pyproject.toml .
COPY uv.lock .
# No build cache mount: Railway requires a cache mount's id= to embed the ID of the service being built, so the
# mount used by the production service would fail the build of a service in another Railway project.
RUN /bin/uv sync --locked --no-install-project --no-dev
COPY ./src /code/src
RUN /bin/uv sync --locked --no-dev

FROM python:3.14-slim-trixie
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates libpq5 \
    && rm -rf /var/lib/apt/lists/*
ENV ATLAS_NO_ANON_TELEMETRY=true
ENV PYTHONUNBUFFERED=1
WORKDIR /code
COPY --from=builder /code /code
# Atlas is invoked via Railway's preDeployCommand, configured in railway.json.
ADD --chmod=555 https://release.ariga.io/atlas/atlas-linux-amd64-latest ./atlas
COPY atlas.hcl .
COPY ./migrations ./migrations
COPY ./tools/migrations ./tools/migrations
CMD exec ./.venv/bin/granian \
    --interface asgi \
    --host 0.0.0.0 \
    --port "${PORT:-8000}" \
    --log-config src/xngin/apiserver/granian_log_config.json \
    --access-log \
    xngin.apiserver.main:app
