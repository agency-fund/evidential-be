CREATE TABLE {{table_name}} (
  `Participant ID` INT64,
  `First Name` STRING,
  `e-mail` STRING,
  `Signup Date` DATE,
  `Last Login` TIMESTAMP,
  `Date of Birth` DATE,
  `Appointment At` DATETIME,
  `Check-in Time` TIME,
  `Score %` NUMERIC(5, 2),
  `isActive` BOOL,
  `Income` FLOAT64,
  `région` STRING,
  `Clinic Name` STRING,
  `visits-count` INT64,
  `select` INT64,
  `it's` STRING,
  `uuid col` STRING,
  `tags` ARRAY<STRING>,
  `profile` JSON,
  `Big Number` BIGNUMERIC,
  `location` GEOGRAPHY,
  `address` STRUCT<city STRING, `postal code` STRING, geo STRUCT<lat FLOAT64, lng FLOAT64>>,
  `events` ARRAY<STRUCT<name STRING, `at` DATE>>
);
