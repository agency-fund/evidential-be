CREATE TABLE {{table_name}} (
  "participant.id" BIGINT PRIMARY KEY,
  "First Name" TEXT,
  "e-mail" VARCHAR(255),
  "Signup Date" DATE,
  "last.login" TIMESTAMPTZ,
  "Date of Birth" DATE,
  "appointment at (local)" TIMESTAMP,
  "check-in time" TIME,
  "check-in time (tz)" TIMETZ,
  "Score (%)" NUMERIC(5, 2),
  "isActive" BOOLEAN,
  "Income $" DOUBLE PRECISION,
  "région" TEXT,
  "Clinic Name" TEXT,
  "visits-count" INTEGER,
  "select" INTEGER,
  "say ""hi""" TEXT,
  "uuid col" UUID,
  "tags" TEXT[],
  "profile" JSONB
);
