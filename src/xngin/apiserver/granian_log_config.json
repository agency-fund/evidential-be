{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {},
  "handlers": {
    "loguru": {
      "()": "xngin.apiserver.customlogging.granian_handler"
    }
  },
  "root": {
    "handlers": ["loguru"],
    "level": "NOTSET"
  },
  "loggers": {
    "_granian": {
      "level": "INFO",
      "propagate": true
    },
    "granian.access": {
      "level": "INFO",
      "propagate": true
    }
  }
}
